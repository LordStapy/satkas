<KaspaWalletSetupPage>:
    md_bg_color: app.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        padding: dp(30)

        # Title and description
        MDBoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(70)
            spacing: dp(10)

            MDLabel:
                text: "Configure Kaspa Wallet"
                font_style: "Headline"
                size_hint_y: None
                height: dp(40)
                halign: 'center'

            MDLabel:
                text: "Choose your Kaspa wallet implementation and configure it for managing funds."
                font_style: "Body"
                size_hint_y: None
                height: dp(30)
                halign: 'center'
                theme_text_color: "Secondary"

        # Wallet type selection
        MDBoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(120)
            spacing: dp(10)
            pos_hint: {'center_x': 0.5}
            size_hint_x: 0.6

            MDLabel:
                text: "Wallet Type:"
                font_style: "Body"
                size_hint_y: None
                height: dp(30)

            MDBoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(30)
                spacing: dp(10)

                MDButton:
                    size_hint_x: 0.33
                    md_bg_color: app.theme_cls.primaryColor if root.selected_wallet_type == "external" else app.theme_cls.surfaceColor
                    style: "filled" if root.selected_wallet_type == "external" else "outlined"
                    theme_text_color: "Custom"
                    on_release: root.on_wallet_type_selected("external")

                    MDButtonText:
                        text: "External"
                        text_color: app.theme_cls.onPrimaryColor if root.selected_wallet_type == "external" else app.theme_cls.onSurfaceColor

                MDButton:
                    size_hint_x: 0.33
                    md_bg_color: app.theme_cls.primaryColor if root.selected_wallet_type == "go" else app.theme_cls.surfaceColor
                    style: "filled" if root.selected_wallet_type == "go" else "outlined"
                    theme_text_color: "Custom"
                    on_release: root.on_wallet_type_selected("go")

                    MDButtonText:
                        text: "Go Wallet"
                        text_color: app.theme_cls.onPrimaryColor if root.selected_wallet_type == "go" else app.theme_cls.onSurfaceColor

                # Rusty wallet disabled: untested
                # MDButton:
                #     size_hint_x: 0.33
                #     md_bg_color: app.theme_cls.primaryColor if root.selected_wallet_type == "rusty" else app.theme_cls.surfaceColor
                #     style: "filled" if root.selected_wallet_type == "rusty" else "outlined"
                #     theme_text_color: "Custom"
                #     on_release: root.on_wallet_type_selected("rusty")
                #
                #     MDButtonText:
                #         text: "Rusty"
                #         text_color: app.theme_cls.onPrimaryColor if root.selected_wallet_type == "rusty" else app.theme_cls.onSurfaceColor

            # Description of selected wallet type
            MDLabel:
                id: wallet_description
                text: [wt['description'] for wt in root.wallet_types if wt['value'] == root.selected_wallet_type][0] if root.selected_wallet_type else ""
                size_hint_y: None
                height: dp(30)
                theme_text_color: "Secondary"

        MDBoxLayout:
            orientation: 'vertical'
            size_hint: 0.6, 1
            pos_hint: {"center_x": 0.5}

            MDScrollView:
                size_hint_x: 1
                size_hint_y: None
                height: min(config_box.height, self.parent.height) if self.parent else config_box.height
                do_scroll_x: False
                do_scroll_y: True
                bar_width: 4
                scroll_y: 1

                MDBoxLayout:
                    id: config_box
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 0 if root.selected_wallet_type == "external" else self.minimum_height
                    spacing: 0
                    padding: [dp(20), dp(20), dp(20), dp(24)] if root.selected_wallet_type != "external" else 0
                    size_hint_x: 1
                    md_bg_color: app.theme_cls.surfaceContainerHighColor if root.selected_wallet_type != "external" else app.theme_cls.backgroundColor
                    opacity: 1 if root.selected_wallet_type != "external" else 0
                    disabled: root.selected_wallet_type == "external"

                    MDBoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height if root.selected_wallet_type == "go" else 0
                        spacing: dp(16)
                        opacity: 1 if root.selected_wallet_type == "go" else 0
                        disabled: root.selected_wallet_type != "go"

                        MDTextField:
                            text: root.binary_path
                            write_tab: False
                            multiline: False
                            size_hint_y: None
                            height: dp(56) if root.selected_wallet_type == "go" else 0
                            theme_text_color: "Custom"
                            text_color_normal: app.theme_cls.onSurfaceColor
                            text_color_focus: app.theme_cls.onSurfaceColor
                            on_text: root.on_binary_path_text(self.text)
                            MDTextFieldHintText:
                                text: "Wallet Binary Path"

                        MDTextField:
                            text: root.wallet_file_path
                            write_tab: False
                            multiline: False
                            size_hint_y: None
                            height: dp(56)
                            theme_text_color: "Custom"
                            text_color_normal: app.theme_cls.onSurfaceColor
                            text_color_focus: app.theme_cls.onSurfaceColor
                            on_text: root.on_wallet_file_path_text(self.text)
                            MDTextFieldHintText:
                                text: "Wallet File Path"

                        MDTextField:
                            text: root.wallet_password
                            write_tab: False
                            multiline: False
                            password: True
                            size_hint_y: None
                            height: dp(56)
                            theme_text_color: "Custom"
                            text_color_normal: app.theme_cls.onSurfaceColor
                            text_color_focus: app.theme_cls.onSurfaceColor
                            on_text: root.on_wallet_password_text(self.text)
                            MDTextFieldHintText:
                                text: "Wallet Password"

                        MDBoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(15)
                            size_hint_y: None
                            height: dp(56)

                            MDTextField:
                                text: root.daemon_host
                                size_hint_x: 0.7
                                write_tab: False
                                multiline: False
                                theme_text_color: "Custom"
                                text_color_normal: app.theme_cls.onSurfaceColor
                                text_color_focus: app.theme_cls.onSurfaceColor
                                on_text: root.on_daemon_host_text(self.text)
                                MDTextFieldHintText:
                                    text: "Daemon Host"

                            MDTextField:
                                text: root.daemon_port
                                size_hint_x: 0.3
                                write_tab: False
                                multiline: False
                                input_filter: 'int'
                                theme_text_color: "Custom"
                                text_color_normal: app.theme_cls.onSurfaceColor
                                text_color_focus: app.theme_cls.onSurfaceColor
                                on_text: root.on_daemon_port_text(self.text)
                                MDTextFieldHintText:
                                    text: "Daemon Port"

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(40) if root.selected_wallet_type == "go" else 0
                            size_hint_x: 0.6
                            MDButton:
                                on_release: root.use_defaults()
                                MDButtonText:
                                    text: "Use Default Settings"

                    # Rusty wallet config disabled: untested
                    # MDBoxLayout:
                    #     orientation: 'vertical'
                    #     size_hint_y: None
                    #     height: self.minimum_height if root.selected_wallet_type == "rusty" else 0
                    #     spacing: dp(16)
                    #     opacity: 1 if root.selected_wallet_type == "rusty" else 0
                    #     disabled: root.selected_wallet_type != "rusty"
                    #
                    #     MDTextField:
                    #         text: root.binary_path
                    #         write_tab: False
                    #         multiline: False
                    #         size_hint_y: None
                    #         height: dp(56) if root.selected_wallet_type == "rusty" else 0
                    #         theme_text_color: "Custom"
                    #         text_color_normal: app.theme_cls.onSurfaceColor
                    #         text_color_focus: app.theme_cls.onSurfaceColor
                    #         on_text: root.on_binary_path_text(self.text)
                    #         MDTextFieldHintText:
                    #             text: "Wallet Binary Path"
                    #
                    #     MDTextField:
                    #         text: root.wallet_name
                    #         write_tab: False
                    #         multiline: False
                    #         size_hint_y: None
                    #         height: dp(56)
                    #         theme_text_color: "Custom"
                    #         text_color_normal: app.theme_cls.onSurfaceColor
                    #         text_color_focus: app.theme_cls.onSurfaceColor
                    #         on_text: root.on_wallet_name_text(self.text)
                    #         MDTextFieldHintText:
                    #             text: "Wallet Name"
                    #
                    #     MDTextField:
                    #         text: root.wallet_password
                    #         write_tab: False
                    #         multiline: False
                    #         password: True
                    #         size_hint_y: None
                    #         height: dp(56)
                    #         theme_text_color: "Custom"
                    #         text_color_normal: app.theme_cls.onSurfaceColor
                    #         text_color_focus: app.theme_cls.onSurfaceColor
                    #         on_text: root.on_wallet_password_text(self.text)
                    #         MDTextFieldHintText:
                    #             text: "Wallet Password"
                    #
                    #     MDBoxLayout:
                    #         size_hint_y: None
                    #         height: dp(40) if root.selected_wallet_type == "rusty" else 0
                    #         size_hint_x: 0.6
                    #         MDButton:
                    #             on_release: root.use_defaults()
                    #             MDButtonText:
                    #                 text: "Use Default Settings"

            Widget:
                size_hint_y: 1

        # Validation message
        MDBoxLayout:
            size_hint_y: None
            height: dp(30)
            pos_hint: {'center_x': 0.5}
            size_hint_x: 0.8

            MDLabel:
                id: validation_label
                text: root.validation_message
                halign: 'center'
                theme_text_color: "Error" if "not found" in root.validation_message.lower() or "failed" in root.validation_message.lower() else "Primary"

        # Navigation buttons
        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(50)
            spacing: dp(20)
            pos_hint: {'center_x': 0.5}
            size_hint_x: 0.8

            MDButton:
                size_hint: 0.3, 1
                on_release: root.go_back()
                md_bg_color: app.theme_cls.surfaceColor
                theme_text_color: "Custom"
                text_color: app.theme_cls.onSurfaceColor

                MDButtonText:
                    text: "Back"

            # Spacer
            Widget:
                size_hint_x: 0.4

            # validate and continue button
            MDButton:
                size_hint: 0.3, 1
                on_release: root.validate_and_continue()
                disabled: root.is_validating
                md_bg_color: app.theme_cls.primaryColor
                theme_text_color: "Custom"
                text_color: app.theme_cls.onPrimaryColor

                MDButtonText:
                    text: "Validate & Continue"
