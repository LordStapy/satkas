<PasswordSetupPage>:
    md_bg_color: app.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        padding: dp(30)

        # Title and description
        MDBoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(70)
            spacing: dp(10)

            MDLabel:
                text: "Set Application Password"
                font_style: "Headline"
                size_hint_y: None
                height: dp(40)
                halign: 'center'

            MDLabel:
                text: "Optionally set a password to secure your application. This can be left blank."
                font_style: "Body"
                size_hint_y: None
                height: dp(30)
                halign: 'center'
                theme_text_color: "Secondary"

        # Password input area
        MDBoxLayout:
            orientation: 'vertical'
            spacing: dp(20)
            size_hint_y: None
            height: dp(200)
            pos_hint: {'center_x': 0.5}
            size_hint_x: 0.6

            # Password field
            MDTextField:
                id: password_field
                text: root.password
                password: True
                helper_text: "Enter a password for the application (optional)"
                helper_text_mode: "persistent"
                write_tab: False
                multiline: False
                on_text: root.on_password_text(self.text)
                size_hint_x: 1
                MDTextFieldHintText:
                    text: "Password"

            # Confirm password field
            MDTextField:
                id: confirm_password_field
                text: root.confirm_password
                password: True
                helper_text: "Confirm your password"
                helper_text_mode: "persistent"
                write_tab: False
                multiline: False
                on_text: root.on_confirm_password_text(self.text)
                size_hint_x: 1
                MDTextFieldHintText:
                    text: "Confirm Password"

        # Error message area
        MDBoxLayout:
            size_hint_y: None
            height: dp(30)
            pos_hint: {'center_x': 0.5}
            size_hint_x: 0.8

            MDLabel:
                id: error_label
                text: root.password_error_message
                halign: 'center'
                theme_text_color: "Error"
                opacity: 1 if root.show_password_error else 0

        # Spacer to push buttons to bottom
        Widget:
            size_hint_y: 1

        # Navigation buttons
        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(50)
            spacing: dp(20)
            pos_hint: {'center_x': 0.5}
            size_hint_x: 0.8

            MDButton:
                size_hint: 0.3, 1
                on_release: root.go_back()
                md_bg_color: app.theme_cls.surfaceColor
                theme_text_color: "Custom"
                text_color: app.theme_cls.onSurfaceColor

                MDButtonText:
                    text: "Back"
                    text_color: app.theme_cls.onSurfaceColor

            # Spacer
            Widget:
                size_hint_x: 0.4

            # Next button
            MDButton:
                size_hint: 0.3, 1
                on_release: root.go_next()
                disabled: root.show_password_error
                md_bg_color: app.theme_cls.primaryColor
                theme_text_color: "Custom"

                MDButtonText:
                    text: "Finish Setup"
                    text_color: app.theme_cls.onPrimaryColor
