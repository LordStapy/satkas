<LandingPage>:
    md_bg_color: app.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: 'vertical'
        spacing: 20
        padding: 40
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        size_hint: 0.8, 0.8

        # Spacer
        Widget:
            size_hint_y: 0.2

        # Welcome title
        MDLabel:
            text: "Welcome to Satkas"
            font_style: "Display"
            size_hint_y: None
            height: 60
            halign: 'center'
            theme_text_color: "Primary"

        # Subtitle
        MDLabel:
            text: "Let's get you set up with Kaspa and Lightning Network"
            font_style: "Headline"
            size_hint_y: None
            height: 40
            halign: 'center'
            theme_text_color: "Secondary"

        # Description
        MDLabel:
            text: "This wizard will guide you through configuring:\n\n• Tor for network privacy\n• Kaspa node for blockchain access\n• Kaspa wallet for managing funds\n• Lightning Network wallet for fast payments"
            font_style: "Body"
            size_hint_y: None
            height: 100
            halign: 'center'
            theme_text_color: "Secondary"

        # Spacer
        Widget:
            size_hint_y: 0.1

        # Start button
        MDButton:
            size_hint: None, None
            size: 200, 50
            pos_hint: {'center_x': 0.5}
            on_press: root.start_setup()
            md_bg_color: app.theme_cls.primaryColor
            theme_text_color: "Custom"
            text_color: app.theme_cls.onPrimaryColor

            MDButtonText:
                text: "Start Setup"

        # Spacer
        Widget:
            size_hint_y: 0.2
