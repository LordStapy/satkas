<LnWalletSetupPage>:
    md_bg_color: app.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        padding: dp(30)

        # Title and description
        MDBoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(70)
            spacing: dp(10)

            MDLabel:
                text: "Configure Lightning Wallet"
                font_style: "Headline"
                size_hint_y: None
                height: dp(40)
                halign: 'center'

            MDLabel:
                text: "Choose your Lightning Network wallet for fast, low-fee payments."
                font_style: "Body"
                size_hint_y: None
                height: dp(30)
                halign: 'center'
                theme_text_color: "Secondary"

        MDBoxLayout:
            orientation: 'vertical'
            spacing: dp(10)
            size_hint_y: None
            height: self.minimum_height
            padding: [0, 0, 0, dp(20)]  # Add bottom padding for better scrolling

            # Wallet type selection
            MDBoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: dp(120)
                spacing: dp(10)
                pos_hint: {'center_x': 0.5}
                size_hint_x: 0.6

                MDLabel:
                    text: "Wallet Type:"
                    font_style: "Body"
                    size_hint_y: None
                    height: dp(30)

                MDBoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(30)
                    spacing: dp(10)

                    MDButton:
                        size_hint_x: 0.33
                        md_bg_color: app.theme_cls.primaryColor if root.selected_wallet_type == "external" else app.theme_cls.surfaceColor
                        style: "filled" if root.selected_wallet_type == "external" else "outlined"
                        theme_text_color: "Custom"
                        on_release: root.on_wallet_type_selected("external")

                        MDButtonText:
                            text: "External"
                            text_color: app.theme_cls.onPrimaryColor if root.selected_wallet_type == "external" else app.theme_cls.onSurfaceColor

                    MDButton:
                        size_hint_x: 0.33
                        md_bg_color: app.theme_cls.primaryColor if root.selected_wallet_type == "lnbits" else app.theme_cls.surfaceColor
                        style: "filled" if root.selected_wallet_type == "lnbits" else "outlined"
                        theme_text_color: "Custom"
                        on_release: root.on_wallet_type_selected("lnbits")

                        MDButtonText:
                            text: "LNBits"
                            text_color: app.theme_cls.onPrimaryColor if root.selected_wallet_type == "lnbits" else app.theme_cls.onSurfaceColor

                    MDButton:
                        size_hint_x: 0.33
                        md_bg_color: app.theme_cls.primaryColor if root.selected_wallet_type == "lncli" else app.theme_cls.surfaceColor
                        style: "filled" if root.selected_wallet_type == "lncli" else "outlined"
                        theme_text_color: "Custom"
                        on_release: root.on_wallet_type_selected("lncli")

                        MDButtonText:
                            text: "LND"
                            text_color: app.theme_cls.onPrimaryColor if root.selected_wallet_type == "lncli" else app.theme_cls.onSurfaceColor

                # Description of selected wallet type
                MDLabel:
                    id: wallet_description
                    text: [wt['description'] for wt in root.wallet_types if wt['value'] == root.selected_wallet_type][0] if root.selected_wallet_type else ""
                    size_hint_y: None
                    height: dp(30)
                    theme_text_color: "Secondary"

        MDBoxLayout:
            orientation: 'vertical'
            size_hint: 0.6, 1
            pos_hint: {"center_x": 0.5}

            MDScrollView:
                size_hint_x: 1
                size_hint_y: None
                height: min(config_box.height, self.parent.height) if self.parent else config_box.height
                do_scroll_x: False
                do_scroll_y: True
                bar_width: 4
                scroll_y: 1

                MDBoxLayout:
                    id: config_box
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 0 if root.selected_wallet_type == "external" else self.minimum_height
                    spacing: 0
                    padding: [dp(20), dp(20), dp(20), dp(24)] if root.selected_wallet_type != "external" else 0
                    size_hint_x: 1
                    md_bg_color: app.theme_cls.surfaceContainerHighColor if root.selected_wallet_type != "external" else app.theme_cls.backgroundColor
                    opacity: 1 if root.selected_wallet_type != "external" else 0
                    disabled: root.selected_wallet_type == "external"

                    MDBoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height if root.selected_wallet_type == "lnbits" else 0
                        spacing: dp(16)
                        opacity: 1 if root.selected_wallet_type == "lnbits" else 0
                        disabled: root.selected_wallet_type != "lnbits"

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(56)
                            spacing: dp(15)
                            size_hint_x: 1

                            MDTextField:
                                id: base_url_field
                                text: root.base_url
                                write_tab: False
                                multiline: False
                                theme_text_color: "Custom"
                                text_color_normal: app.theme_cls.onSurfaceColor
                                text_color_focus: app.theme_cls.onSurfaceColor
                                on_text: root.on_base_url_text(self.text)
                                size_hint_x: 0.7
                                MDTextFieldHintText:
                                    text: "LNBits Server URL"

                            MDButton:
                                pos_hint: {"right": 1, "center_y": 0.5}
                                size_hint_x: 0.3
                                on_release: root.show_fallback_dialog()
                                MDButtonText:
                                    text: "Use Hosted LNBits"

                        MDBoxLayout:
                            id: lnbits_defaults_section
                            size_hint_y: None
                            height: dp(40)
                            size_hint_x: 0.6
                            MDButton:
                                id: lnbits_create_account_button
                                pos_hint: {"center_x": 0.5}
                                on_press: root.lnbits_create_account()
                                disabled: root.lnbits_create_disabled
                                MDButtonText:
                                    text: "Create Account"

                        MDTextField:
                            id: user_id_field
                            text: root.user_id
                            write_tab: False
                            multiline: False
                            theme_text_color: "Custom"
                            text_color_normal: app.theme_cls.onSurfaceColor
                            text_color_focus: app.theme_cls.onSurfaceColor
                            on_text: root.on_user_id_text(self.text)
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(56)
                            MDTextFieldHintText:
                                text: "User ID"

                        MDBoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(15)
                            size_hint_y: None
                            height: dp(56)

                            MDTextField:
                                id: read_api_key_field
                                text: root.read_api_key
                                size_hint_x: 0.5
                                write_tab: False
                                multiline: False
                                theme_text_color: "Custom"
                                text_color_normal: app.theme_cls.onSurfaceColor
                                text_color_focus: app.theme_cls.onSurfaceColor
                                on_text: root.on_read_api_key_text(self.text)
                                MDTextFieldHintText:
                                    text: "Read API Key"

                            MDTextField:
                                id: admin_api_key_field
                                text: root.admin_api_key
                                size_hint_x: 0.5
                                write_tab: False
                                multiline: False
                                theme_text_color: "Custom"
                                text_color_normal: app.theme_cls.onSurfaceColor
                                text_color_focus: app.theme_cls.onSurfaceColor
                                on_text: root.on_admin_api_key_text(self.text)
                                MDTextFieldHintText:
                                    text: "Admin API Key"

                        MDTextField:
                            id: wallet_id_field
                            text: root.wallet_id
                            write_tab: False
                            multiline: False
                            theme_text_color: "Custom"
                            text_color_normal: app.theme_cls.onSurfaceColor
                            text_color_focus: app.theme_cls.onSurfaceColor
                            on_text: root.on_wallet_id_text(self.text)
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(56)
                            MDTextFieldHintText:
                                text: "Wallet ID"

                    MDBoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height if root.selected_wallet_type == "lncli" else 0
                        spacing: dp(16)
                        opacity: 1 if root.selected_wallet_type == "lncli" else 0
                        disabled: root.selected_wallet_type != "lncli"

                        MDTextField:
                            id: lncli_bin_field
                            text: root.lncli_bin
                            write_tab: False
                            multiline: False
                            theme_text_color: "Custom"
                            text_color_normal: app.theme_cls.onSurfaceColor
                            text_color_focus: app.theme_cls.onSurfaceColor
                            on_text: root.on_lncli_bin_text(self.text)
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(56)
                            MDTextFieldHintText:
                                text: "lncli Binary Path"

                        MDTextField:
                            id: rpc_server_field
                            text: root.rpc_server
                            write_tab: False
                            multiline: False
                            theme_text_color: "Custom"
                            text_color_normal: app.theme_cls.onSurfaceColor
                            text_color_focus: app.theme_cls.onSurfaceColor
                            on_text: root.on_rpc_server_text(self.text)
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(56)
                            MDTextFieldHintText:
                                text: "LND RPC Server"

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(40)
                            MDButton:
                                on_press: root.use_defaults()
                                MDButtonText:
                                    text: "Use Default Settings"

            Widget:
                size_hint_y: 1

        # Validation message
        MDBoxLayout:
            size_hint_y: None
            height: dp(30)
            pos_hint: {'center_x': 0.5}
            size_hint_x: 0.8

            MDLabel:
                id: validation_label
                text: root.validation_message
                halign: 'center'
                theme_text_color: "Error" if "not accessible" in root.validation_message.lower() or "failed" in root.validation_message.lower() else "Primary"

        # Navigation buttons
        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(50)
            spacing: dp(20)
            pos_hint: {'center_x': 0.5}
            size_hint_x: 0.8

            MDButton:
                size_hint: 0.3, 1
                on_release: root.go_back()
                md_bg_color: app.theme_cls.surfaceColor
                theme_text_color: "Custom"
                text_color: app.theme_cls.onSurfaceColor

                MDButtonText:
                    text: "Back"
                    text_color: app.theme_cls.onSurfaceColor

            # Spacer
            Widget:
                size_hint_x: 0.4

            # Validate and Continue
            MDButton:
                size_hint: 0.3, 1
                on_release: root.validate_and_complete()
                disabled: root.is_validating
                md_bg_color: app.theme_cls.primaryColor
                theme_text_color: "Custom"

                MDButtonText:
                    text: "Validate & Continue"
                    text_color: app.theme_cls.onPrimaryColor

