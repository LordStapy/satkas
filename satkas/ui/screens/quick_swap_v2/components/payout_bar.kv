
<PayoutRowLabel@MDLabel>:
    adaptive_height: True
    pos_hint: {"center_y": 0.5}
    halign: "left"

<PayoutAddressRow@MDCard>:
    orientation: "horizontal"
    style: "filled"
    spacing: dp(12)
    padding: [dp(16), dp(6)]
    size_hint_y: None
    height: dp(56)

<PayoutAddressBar>:
    orientation: "vertical"
    style: "elevated"
    padding: dp(8) if self.is_locked else dp(16)
    spacing: (dp(4) if self.is_locked else dp(12)) if self.show_btc else 0
    size_hint_y: None
    height: self.minimum_height
    md_bg_color: app.theme_cls.surfaceContainerHighColor

    PayoutAddressRow:
        id: kas_row
        height: dp(40) if root.is_locked else dp(56)
        padding: [dp(12), dp(4)] if root.is_locked else [dp(16), dp(6)]
        disabled: root.is_locked
        on_release: root.open_dialog("kas")
        md_bg_color: 112/255, 199/255, 186/255, 0.15

        #PayoutRowLabel:
        #    text: "KAS"
        #    font_style: "Title"
        #    role: "medium"
        #    bold: True
        #    size_hint_x: None
        #    width: dp(36)
        #    theme_text_color: "Custom"
        #    text_color: 0.29, 0.92, 0.80, 1
        #FitImage:
        #    source: root.kaspa_icon
        #    size_hint: None, None
        #    size: (dp(24), dp(24)) if root.is_locked else (dp(32), dp(32))
        #    fit_mode: "contain"
        #    radius: [dp(12)] if root.is_locked else [dp(16)]
        #    pos_hint: {"center_y": 0.5}
        Image:
            source: root.kaspa_icon
            size_hint: None, None
            size: (dp(24), dp(24)) if root.is_locked else (dp(32), dp(32))
            fit_mode: "contain"
            pos_hint: {"center_y": 0.5}

        PayoutRowLabel:
            text: root.kas_role
            font_style: "Title"
            role: "medium"
            size_hint_x: None
            width: dp(85)

        PayoutRowLabel:
            text: root.kas_address_display
            font_style: "Title"
            role: "medium"
            bold: True
            size_hint_x: 1
            shorten: True
            shorten_from: "center"
            text_size: self.width, None

        PayoutRowLabel:
            text: root.kas_source_label
            font_style: "Body"
            role: "medium"
            size_hint_x: None
            width: dp(64)
            opacity: 1 if root.kas_source_label else 0
            theme_text_color: "Custom"
            text_color: app.theme_cls.onSurfaceColor[0], app.theme_cls.onSurfaceColor[1], app.theme_cls.onSurfaceColor[2], 0.55

    PayoutAddressRow:
        id: btc_row
        height: (dp(40) if root.is_locked else dp(56)) if root.show_btc else 0
        padding: [dp(12), dp(4)] if root.is_locked else [dp(16), dp(6)]
        opacity: 1 if root.show_btc else 0
        disabled: root.is_locked or not root.show_btc
        on_release: root.open_dialog("btc")
        md_bg_color: 1, 0.6, 0, 0.15

        #PayoutRowLabel:
        #    text: "BTC"
        #    font_style: "Title"
        #    role: "medium"
        #    bold: True
        #    size_hint_x: None
        #    width: dp(36)
        #FitImage:
        #    source: root.btc_icon
        #    size_hint: None, None
        #    size: (dp(24), dp(24)) if root.is_locked else (dp(32), dp(32))
        #    fit_mode: "contain"
        #    radius: [dp(12)] if root.is_locked else [dp(16)]
        #    pos_hint: {"center_y": 0.5}
        Image:
            source: root.btc_icon
            size_hint: None, None
            size: (dp(24), dp(24)) if root.is_locked else (dp(32), dp(32))
            fit_mode: "contain"
            pos_hint: {"center_y": 0.5}

        PayoutRowLabel:
            text: root.btc_role
            font_style: "Title"
            role: "medium"
            size_hint_x: None
            width: dp(85)

        PayoutRowLabel:
            text: root.btc_address_display
            font_style: "Title"
            role: "medium"
            bold: True
            size_hint_x: 1
            shorten: True
            shorten_from: "center"
            text_size: self.width, None

        PayoutRowLabel:
            text: root.btc_source_label
            font_style: "Body"
            role: "medium"
            size_hint_x: None
            width: dp(64)
            opacity: 1 if root.btc_source_label else 0
            theme_text_color: "Custom"
            text_color: app.theme_cls.onSurfaceColor[0], app.theme_cls.onSurfaceColor[1], app.theme_cls.onSurfaceColor[2], 0.55
