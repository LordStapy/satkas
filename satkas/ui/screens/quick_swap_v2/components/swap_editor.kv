
<SwapEditor>:
    style: "elevated"
    #orientation: "vertical"
    padding: dp(16) if self.is_editing else dp(10)
    spacing: 0
    size_hint_y: None
    height: dp(264) if self.is_editing else dp(48)
    md_bg_color: app.theme_cls.surfaceContainerHighColor
    
    # Editing Mode - Dual card layout
    MDBoxLayout:
        orientation: "vertical"
        spacing: 0
        size_hint_x: 1 if root.is_editing else None
        width: root.width if root.is_editing else 0
        opacity: 1 if root.is_editing else 0
        disabled: not root.is_editing

        # Off-chain / On-chain mode selector
        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(36)
            spacing: dp(8)

            MDButton:
                size_hint_x: 0.5
                style: "filled" if root.swap_mode == "offchain" else "outlined"
                md_bg_color: app.theme_cls.primaryColor if root.swap_mode == "offchain" else app.theme_cls.surfaceColor
                on_release: root.set_swap_mode("offchain")
                MDButtonText:
                    text: "Off-chain (LN)"
                    text_color: app.theme_cls.onPrimaryColor if root.swap_mode == "offchain" else app.theme_cls.onSurfaceColor

            MDButton:
                size_hint_x: 0.5
                style: "filled" if root.swap_mode == "onchain" else "outlined"
                md_bg_color: app.theme_cls.primaryColor if root.swap_mode == "onchain" else app.theme_cls.surfaceColor
                on_release: root.set_swap_mode("onchain")
                MDButtonText:
                    text: "On-chain"
                    text_color: app.theme_cls.onPrimaryColor if root.swap_mode == "onchain" else app.theme_cls.onSurfaceColor

        MDWidget:
            size_hint_y: None
            height: dp(12)

        # Send Amount Card
        MDCard:
            style: "filled"
            size_hint_y: None
            height: dp(64)
            md_bg_color: (112/255, 199/255, 186/255, 0.15) if root.sends_kas else (1, 0.6, 0, 0.15)
            
            MDBoxLayout:
                orientation: "horizontal"
                spacing: dp(12)
                padding: [dp(16), dp(8), dp(16), dp(8)]
                
                MDLabel:
                    text: "You send"
                    font_style: "Title"
                    role: "medium"
                    bold: True
                    size_hint_x: 0.3
                    pos_hint: {"center_y": 0.5}
                
                MDTextField:
                    id: send_input
                    mode: "filled"
                    text: root.send_amount_display
                    input_filter: None if root.quote_failed else "float"
                    font_style: "Title"
                    role: "small"
                    size_hint_x: 0.5
                    size_hint_y: None
                    height: dp(48)
                    on_text: root.on_amount_input(self, self.text)
                    on_focus: root.on_field_focus(self, self.focus)
                    theme_text_color: "Custom"
                    text_color_normal: (app.theme_cls.onSurfaceVariantColor[0], app.theme_cls.onSurfaceVariantColor[1], app.theme_cls.onSurfaceVariantColor[2], 0.4 if root.send_text_faded else 1)
                    text_color_focus: (app.theme_cls.onSurfaceColor[0], app.theme_cls.onSurfaceColor[1], app.theme_cls.onSurfaceColor[2], 0.4 if root.send_text_faded else 1)
                    MDTextFieldHintText:
                        text: "Amount"
                
                MDLabel:
                    text: "KAS" if root.sends_kas else "BTC"
                    font_style: "Title"
                    role: "medium"
                    bold: True
                    size_hint_x: 0.2
                    halign: "center"
                    pos_hint: {"center_y": 0.5}
                    theme_text_color: "Custom"
                    text_color: (112/255, 199/255, 186/255, 1) if root.sends_kas else (1, 0.6, 0, 1)

        MDWidget:
            size_hint_y: None
            height: dp(4)

        # Direction Switch Button
        MDIconButton:
            icon: "swap-vertical-bold"
            style: "outlined"
            pos_hint: {"center_x": 0.5}
            size_hint: None, None
            size: dp(48), dp(48)
            on_release: root.switch_direction()

        MDWidget:
            size_hint_y: None
            height: dp(4)

        # Receive Amount Card
        MDCard:
            style: "filled"
            size_hint_y: None
            height: dp(64)
            md_bg_color: (1, 0.6, 0, 0.15) if root.sends_kas else (112/255, 199/255, 186/255, 0.15)
            
            MDBoxLayout:
                orientation: "horizontal"
                spacing: dp(12)
                padding: [dp(16), dp(8), dp(16), dp(8)]
                
                MDLabel:
                    text: "You receive"
                    font_style: "Title"
                    role: "medium"
                    bold: True
                    size_hint_x: 0.3
                    pos_hint: {"center_y": 0.5}

                MDTextField:
                    id: receive_input
                    mode: "filled"
                    text: root.receive_amount_display
                    input_filter: None if root.quote_failed else "float"
                    font_style: "Title"
                    role: "small"
                    size_hint_x: 0.5
                    size_hint_y: None
                    height: dp(48)
                    on_text: root.on_amount_input(self, self.text)
                    on_focus: root.on_field_focus(self, self.focus)
                    theme_text_color: "Custom"
                    text_color_normal: (app.theme_cls.onSurfaceVariantColor[0], app.theme_cls.onSurfaceVariantColor[1], app.theme_cls.onSurfaceVariantColor[2], 0.4 if root.receive_text_faded else 1)
                    text_color_focus: (app.theme_cls.onSurfaceColor[0], app.theme_cls.onSurfaceColor[1], app.theme_cls.onSurfaceColor[2], 0.4 if root.receive_text_faded else 1)
                    MDTextFieldHintText:
                        text: "Amount"
                
                MDLabel:
                    text: "BTC" if root.sends_kas else "KAS"
                    font_style: "Title"
                    role: "medium"
                    bold: True
                    size_hint_x: 0.2
                    halign: "center"
                    pos_hint: {"center_y": 0.5}
                    theme_text_color: "Custom"
                    text_color: (1, 0.6, 0, 1) if root.sends_kas else (112/255, 199/255, 186/255, 1)

    
    # Collapsed Mode - Single row summary
    MDBoxLayout:
        orientation: "horizontal"
        size_hint_x: 0 if root.is_editing else 1
        spacing: dp(12)
        padding: [dp(16), 0, dp(16), 0]
        opacity: 0 if root.is_editing else 1
        disabled: root.is_editing

        MDLabel:
            text: root.summary_display
            font_style: "Title"
            role: "medium"
            halign: "center"
            pos_hint: {"center_y": 0.5}
        
        MDIcon:
            id: editor_collapsed_icon
            icon: "check-circle"
            theme_text_color: "Custom"
            text_color: (0, 0.8, 0, 1)
            size_hint: None, None
            size: dp(24), dp(24)
            pos_hint: {"center_y": 0.5}

