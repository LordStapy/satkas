
<ContractAddressField>:
    style: "filled"
    orientation: "vertical"
    padding: dp(12)
    spacing: dp(8)
    size_hint_y: None if self.is_visible else 0
    height: 0 if not self.is_visible else self.minimum_height
    opacity: 0 if not self.is_visible else 1
    md_bg_color: app.theme_cls.surfaceContainerHighColor
    
    # Row 1: Title and Status
    MDBoxLayout:
        orientation: "horizontal"
        spacing: dp(12)
        adaptive_height: True
        
        MDLabel:
            text: root.title_text
            font_style: "Title"
            role: "medium"
            bold: True
            adaptive_size: True
        
        MDLabel:
            id: contract_status_label
            text: root.status_text
            font_style: "Body"
            role: "large"
            adaptive_size: True
            theme_text_color: "Custom"
            text_color: (0, 0.8, 0, 1) if root.is_confirmed else app.theme_cls.primaryColor

        MDWidget:
            size_hint_y: None
            height: 0

    # Who funds this side (taker vs maker) — set at swap init
    #MDLabel:
    #    text: root.description_text
    #    font_style: "Body"
    #    role: "small"
    #    theme_text_color: "Secondary"
    #    adaptive_height: True
    #    size_hint_y: None
    #    height: 0 if not root.description_text else self.texture_size[1]
    #    opacity: 0 if not root.description_text else 1
    
    # Row 2: Address Label and QR Button
    MDBoxLayout:
        orientation: "horizontal"
        spacing: dp(8)
        #adaptive_height: True
        size_hint: None, None
        height: dp(48)
        width: min(dp(8*64) + dp(56), root.width - dp(24))  # ToDo: find a way to make this dynamic (in case of font size increase/decrease)
        
        # Copyable address label
        MDLabel:
            id: contract_address_label
            #md_bg_color: 1, 0, 0, 0.5
            text: root.contract_address_display
            font_style: "Body"
            role: "medium"
            adaptive_height: True
            shorten: True
            shorten_from: "center"

            pos_hint: {"center_y": 0.5}
            theme_text_color: "Secondary"
        
        # QR Icon Button
        MDIconButton:
            icon: "qrcode"
            style: "standard"
            size_hint: None, None
            size: dp(48), dp(48)
            pos_hint: {"center_y": 0.5}
            disabled: not root.contract_address
            on_release: root.show_qr_popup()
        
        # Spacer - pushes remaining space to the right
        #MDWidget:
            #md_bg_color: 1, 0, 1, 0.4
            #size_hint: None, 0
            #width: max(root.width - dp(9*62 + 88), 0)
